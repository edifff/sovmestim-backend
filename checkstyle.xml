<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Checkstyle-Configuration: Strong checkstyle
    Description: none
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="MissingJavadocMethod">
            <property name="allowedAnnotations" value="Override,Deprecated,Bean"/>
            <property name="ignoreMethodNamesRegex" value="^get.*|^set.*|^is.*" />
            <property name="scope" value="protected"/>
        </module>
        <module name="MissingJavadocType">
            <property name="scope" value="private"/>
            <property name="skipAnnotations" value="SpringBootApplication,Configuration"/>
        </module>
        <module name="JavadocMethod">
            <property name="validateThrows" value="true"/>
        </module>
        <module name="JavadocType"/>
        <module name="JavadocStyle">
            <property name="checkEmptyJavadoc" value="true"/>
        </module>
        <module name="ConstantName"/>
        <module name="UpperEll"/>
        <module name="AvoidStaticImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="ImportOrder">
            <property name="option" value="above"/>
            <property name="groups" value="/^java\./,javax,/^com\./,io,org,lombok,reactor,ru.usetech"/>
            <property name="separated" value="true"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="50"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        <module name="AnonInnerLength">
            <property name="max" value="25"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="10"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        <module name="OuterTypeNumber"/>
        <module name="GenericWhitespace"/>
        <module name="WhitespaceAfter">
            <!-- all except typecase -->
            <property name="tokens" value="COMMA, SEMI"/>
        </module>
        <module name="WhitespaceAround">
            <property name="tokens"
                      value="ASSIGN, BAND, BAND_ASSIGN, BOR, BOR_ASSIGN, BSR, BSR_ASSIGN, BXOR, BXOR_ASSIGN, COLON, DIV, DIV_ASSIGN, EQUAL, GE, GT, LAND, LCURLY, LE, LITERAL_ASSERT, LITERAL_CATCH, LITERAL_DO, LITERAL_ELSE, LITERAL_FINALLY, LITERAL_FOR, LITERAL_IF, LITERAL_RETURN, LITERAL_SYNCHRONIZED, LITERAL_TRY, LITERAL_WHILE, LOR, LT, MINUS, MINUS_ASSIGN, MOD, MOD_ASSIGN, NOT_EQUAL, PLUS, PLUS_ASSIGN, QUESTION, SL, SL_ASSIGN, SLIST, SR, SR_ASSIGN, STAR, STAR_ASSIGN, TYPE_EXTENSION_AND"/>
        </module>
        <module name="NoWhitespaceBefore"/>
        <module name="NoWhitespaceAfter"/>
        <module name="MethodParamPad"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="NeedBraces"/>
        <module name="DeclarationOrder"/>
        <module name="EmptyStatement"/>
        <module name="EqualsAvoidNull"/>
        <module name="EqualsHashCode"/>
        <module name="ModifiedControlVariable">
            <property name="severity" value="warning"/>
        </module>
        <module name="MultipleStringLiterals">
            <property name="severity" value="warning"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>
        <module name="HideUtilityClassConstructor"/>
        <module name="CyclomaticComplexity">
            <property name="max" value="20"/>
            <message key="cyclomaticComplexity"
                     value="Method is too complex - there are more than 20 control flow elements (if, case, ..)"/>
        </module>
        <module name="InnerTypeLast"/>
        <module name="MissingOverride"/>
        <module name="VisibilityModifier"/>
        <module name="TodoComment"/>
        <module name="TrailingComment"/>
        <module name="RegexpSinglelineJava">
            <property name="format" value="noinspection unchecked"/>
            <property name="message" value="IDEA-specific comments are not allowed"/>
        </module>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingDeprecated"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="OneStatementPerLine"/>
        <module name="ArrayTypeStyle"/>
        <module name="DefaultComesLast"/>
        <module name="IllegalThrows"/>
        <module name="OuterTypeFilename"/>
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z]{1,}$"/>
        </module>
        <module name="ConstantName"/>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <module name="MethodTypeParameterName"/>
        <module name="PackageName">
            <property name="format" value="^ru\.sovmestim(\.[a-z]+(\.[a-z_][a-z0-9_]*)*)?$"/>
        </module>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <module name="TypeName"/>
    </module>
    <module name="FileTabCharacter">
        <property name="fileExtensions" value="java, xml, xslt, cpp, c, h"/>
    </module>
    <module name="NewlineAtEndOfFile">
        <property name="fileExtensions" value="java, xml, sql, properties, css, cpp, c, h"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace"/>
        <property name="fileExtensions" value="java, xml, sql, css, cpp, c, h"/>
    </module>
    <module name="Translation"/>
</module>
