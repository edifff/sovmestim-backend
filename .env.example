# Copy to .env and adjust. compose.yaml reads these with sensible defaults.
POSTGRES_PASSWORD=sovmestim
SOVMESTIM_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# One-time login codes.
#   log  = write a masked address to the log (development)
#   smtp = actually send the code by e-mail
SOVMESTIM_OTP_CHANNEL=log
# Return the code in the API response (development). Set to false in production.
SOVMESTIM_OTP_DEBUG=true
# Sender address of OTP e-mails; required when SOVMESTIM_OTP_CHANNEL=smtp.
SOVMESTIM_OTP_FROM=

# SMTP connection, required only when SOVMESTIM_OTP_CHANNEL=smtp.
# Keep real credentials in .env (git-ignored), never in compose.yaml or this template.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
