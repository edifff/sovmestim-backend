
# One image definition for every service. MODULE selects which Maven module is packaged;
# HEALTH_PORT is the actuator port the container healthcheck probes.

ARG MODULE

FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /workspace

ARG MODULE

# The whole reactor is copied because a service build needs proto + common + its own module.
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -Dmaven.test.skip=true -pl ${MODULE} -am package

FROM eclipse-temurin:25-jre

ARG MODULE
ARG HEALTH_PORT=8080
ENV HEALTH_PORT=${HEALTH_PORT}

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 appuser

WORKDIR /app
COPY --from=build /workspace/${MODULE}/target/*-exec.jar app.jar

USER appuser
EXPOSE ${HEALTH_PORT}

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
    CMD curl -fsS http://localhost:${HEALTH_PORT}/actuator/health | grep -q '"status":"UP"' || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
